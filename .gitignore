# Runtime sandbox: per-run homes, configs, caches and transcripts (never committed)
.sandbox/

# Credentials never live in the project (see CLAUDE.md); belt and braces:
*.env
!tools/versions.env
secrets*

# Installed tools, all by ./setup.sh: binaries, Node, Python, node_modules, venvs, download cache.
# The pins stay in git: tools/versions.env, tools/requirements-*.txt, tools/**/package(-lock).json
tools/bin/
tools/node/
tools/python/
tools/.pkg/
tools/.downloads/
tools/node_modules/
tools/claude-code/node_modules/
tools/.venv/
tools/.venv-store/

# Written by bin/make-templates (run by ./setup.sh) with this clone's absolute path
conditions/*/settings.json

# Generated by bin/setup (each world holds its own nested git repos)
worlds/

# Raw per-run logs (large, regenerated by bin/verify); summaries in results/*.md|json stay
results/raw/

__pycache__/
*.pyc

# Live-session transcripts (personal exploration, raw model context)
results/sessions/

# Local, personal documents (e.g. workshop follow-up emails); never committed
local-docs/
