#!/usr/bin/env python3
"""Generate SCENARIOS.md from scenarios/*.json and the latest results/verify-*.json. Never edit SCENARIOS.md by hand."""
import json
import sys
import os
from pathlib import Path

P = Path(__file__).resolve().parent.parent
PY = str(P / "tools/.venv-store/bin/python")
if sys.executable != PY:  # always the project's Python (macOS ships 3.9), set up by ./setup.sh
    os.execv(PY, [PY, *sys.argv])
CONFIGS = ["X-A0", "X-A1", "X-G2", "X-G3", "X-G4", "X-A5"]
NAMES = {"X-A0": "own repo", "X-A1": "search", "X-G2": "syntax", "X-G3": "SCIP", "X-G4": "contract", "X-A5": "all"}
scs = [json.loads(f.read_text()) for f in sorted((P / "scenarios").glob("*.json"))]
latest = {}
for f in sorted((P / "results").glob("verify-*.json")):          # later files override earlier ones, per cell
    latest.update({k: v | {"file": f.stem} for k, v in json.loads(f.read_text()).items()})
mark = {"correct": "✓", "wrong": "✗"}
CORE = [("T2", "X-G2"), ("T3", "X-G3"), ("T4", "X-G4")]
by_id = {s["id"]: s for s in scs}
L = ["# Scenarios", "", "_Generated by `bin/make-docs` from `scenarios/*.json` and `results/verify-*.json`._", "",
     "## The core 3x3", "",
     "Three scenarios, each won by exactly one graph. Configurations: syntax graph (X-G2), compiler index (X-G3),",
     "contract graph (X-G4) — each with its own repo plus file access, no search. Run: `bin/verify --core`.", "",
     "| Scenario | Syntax graph | Compiler index (SCIP) | Contract graph |", "|---|---|---|---|"]
for sid, _ in CORE:
    s0 = by_id[sid]; row = []
    for c in ("X-G2", "X-G3", "X-G4"):
        r = latest.get(f"{sid}/{c}")
        meas = f"{r['verdicts'].count('correct')}/{len(r['verdicts'])}" if r else "–"
        row.append(f"{mark[s0['expected'][c]]} {meas}" + ("" if (r is None or r['pass']) else " **FAIL**"))
    L.append(f"| **{sid}** {s0['plain']} | " + " | ".join(row) + " |")
L += ["", "Why: T2 — web-app can't be built, so SCIP has no index while the syntax graph still parses it. "
      "T3 — only SCIP knows which `hello` a call refers to across repos. T4 — only the contract graph links a Python API "
      "field to the TypeScript query that uses it.", "", "## All scenarios", "",
     "Each scenario asks one question from one team's repo. Expected result per configuration: ✓ correct, ✗ wrong.",
     "Measured = correct runs / runs in the latest `bin/verify` of that cell (Haiku).", "",
     "| | Question (asked from) | " + " | ".join(NAMES[c] for c in CONFIGS) + " |",
     "|---|---|" + "---|" * len(CONFIGS)]
for s in scs:
    cells = []
    for c in CONFIGS:
        r = latest.get(f"{s['id']}/{c}")
        meas = f"{r['verdicts'].count('correct')}/{len(r['verdicts'])}" if r else "–"
        cells.append(f"{mark[s['expected'][c]]} {meas}" + ("" if (r is None or r['pass']) else " **FAIL**"))
    L.append(f"| **{s['id']}** {s['title']} | {s['plain']} ({s['workspace']}) | " + " | ".join(cells) + " |")
L.append("")
for s in scs:
    L += [f"## {s['id']} — {s['title']}", "",
          f"- **World:** `{s['world']}` · **asked from:** `{s['workspace']}`" + (f" · **read limit:** {s['read_limit']} file" if s.get('read_limit') else ""),
          f"- **Plain meaning:** {s['plain']}", f"- **Question (exact):** {s['question']}",
          f"- **Lesson:** {s['lesson']}", "", "**Answer key:**", "", *[f"> {l}" for l in s["answer_key"].splitlines()], "",
          "**Deterministic checks (`bin/check`):**", ""]
    for ck in s["tool_checks"]:
        parts = ([f"contains {ck['contains']}"] if ck.get("contains") else []) + ([f"lacks {ck['absent']}"] if ck.get("absent") else [])
        L.append(f"- `{ck['layer']}` `{ck['call']}({', '.join(ck['args'])})` → {'; '.join(parts)}")
    L += ["", f"Run it live: `bin/session X-G3 {s['id']}` (any configuration) · graded: `bin/verify {s['id']}`", ""]
(P / "SCENARIOS.md").write_text("\n".join(L) + "\n")
print("SCENARIOS.md written")

# core-3x3.html: the "measured" badges of the core cells, from the same latest results
H = P / "core-3x3.html"
BEGIN, END = "// BEGIN measured", "// END measured"
html = H.read_text()
i, j = html.index(BEGIN), html.index(END)
cells = {(sid, c): latest.get(f"{sid}/{c}") for sid, _ in CORE for c in ("X-G2", "X-G3", "X-G4")}
meas = {f"{sid} {c}": f"{r['verdicts'].count('correct')}/{len(r['verdicts'])}" for (sid, c), r in cells.items() if r}
days = sorted({r["file"][len("verify-"):][:8] for r in cells.values() if r})
days = [f"{d[:4]}-{d[4:6]}-{d[6:]}" for d in days]
fails = sum(1 for r in cells.values() if r and not r["pass"])
missing = sum(1 for r in cells.values() if not r)
when = days[0] if len(days) == 1 else (f"{days[0]} to {days[-1]}" if days else "never")
status = "all cells PASS" if not (fails or missing) else ", ".join(x for x in (
    f"{fails} cell(s) FAIL" if fails else "", f"{missing} cell(s) not run" if missing else "") if x)
rows = [", ".join(f'"{sid} {c}": "{meas[f"{sid} {c}"]}"' for c in ("X-G2", "X-G3", "X-G4") if f"{sid} {c}" in meas)
        for sid, _ in CORE]
block = (BEGIN + " (generated by bin/make-docs from results/verify-*.json; do not edit by hand)\n"
         "// Latest bin/verify result per core cell: correct runs / runs.\n"
         "const MEASURED = {" + ",\n  ".join(r for r in rows if r) + "};\n"
         f'const MEASURED_LABEL = "Last verify ({when}, Haiku, {status})";\n')
H.write_text(html[:i] + block + html[j:])
print("core-3x3.html measured badges written")
